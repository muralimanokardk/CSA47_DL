import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers

np.random.seed(42)
tf.random.set_seed(42)

def loss_func(w1, w2):
    return 0.1 * w1**2 + 2.0 * w2**2

def grad_func(w1, w2):
    return np.array([0.2 * w1, 4.0 * w2])

lr = 0.1
epochs = 50
start_point = np.array([4.0, 3.0])

def run_gd(start, lr, epochs):
    path = [start.copy()]
    w = start.copy()
    for _ in range(epochs):
        grad = grad_func(w[0], w[1])
        w -= lr * grad
        path.append(w.copy())
    return np.array(path)

def run_sgd_noisy(start, lr, epochs):
    path = [start.copy()]
    w = start.copy()
    for _ in range(epochs):
        grad = grad_func(w[0], w[1]) + np.random.normal(0, 0.5, size=2)
        w -= lr * grad
        path.append(w.copy())
    return np.array(path)

def run_momentum(start, lr, epochs, beta=0.9):
    path = [start.copy()]
    w = start.copy()
    v = np.zeros(2)
    for _ in range(epochs):
        grad = grad_func(w[0], w[1])
        v = beta * v + lr * grad
        w -= v
        path.append(w.copy())
    return np.array(path)

def run_adam(start, lr, epochs, beta1=0.9, beta2=0.999, eps=1e-8):
    path = [start.copy()]
    w = start.copy()
    m = np.zeros(2)
    v = np.zeros(2)
    for t in range(1, epochs + 1):
        grad = grad_func(w[0], w[1])
        m = beta1 * m + (1 - beta1) * grad
        v = beta2 * v + (1 - beta2) * (grad**2)
        m_hat = m / (1 - beta1**t)
        v_hat = v / (1 - beta2**t)
        w -= lr * m_hat / (np.sqrt(v_hat) + eps)
        path.append(w.copy())
    return np.array(path)

path_gd = run_gd(start_point, lr, epochs)
path_sgd = run_sgd_noisy(start_point, lr, epochs)
path_mom = run_momentum(start_point, lr, epochs)
path_adam = run_adam(start_point, lr=0.3, epochs=epochs)

w1_vals = np.linspace(-5, 5, 200)
w2_vals = np.linspace(-4, 4, 200)
W1, W2 = np.meshgrid(w1_vals, w2_vals)
Z = loss_func(W1, W2)

plt.figure(figsize=(10, 7))
plt.contour(W1, W2, Z, levels=np.logspace(-1, 2, 20), cmap='jet')
plt.plot(path_gd[:, 0], path_gd[:, 1], 'r-o', label='Batch GD', markersize=3)
plt.plot(path_sgd[:, 0], path_sgd[:, 1], 'g-o', label='SGD (Noisy)', markersize=3)
plt.plot(path_mom[:, 0], path_mom[:, 1], 'b-o', label='Momentum', markersize=3)
plt.plot(path_adam[:, 0], path_adam[:, 1], 'm-o', label='Adam', markersize=3)
plt.title('Optimization Paths on Loss Surface')
plt.xlabel('w1')
plt.ylabel('w2')
plt.legend()
plt.grid(True)
plt.show()

n_samples = 1000
X = np.random.uniform(0, 10, size=(n_samples, 4))
y = 2.5 * X[:, 0] - 1.2 * X[:, 1] + 0.8 * X[:, 2] + 0.5 * X[:, 3] + np.random.normal(0, 1, size=n_samples)

X_train, y_train = X[:800], y[:800]
X_val, y_val = X[800:], y[800:]

def build_model():
    return keras.Sequential([
        layers.Dense(32, activation='relu', input_shape=(4,)),
        layers.Dense(16, activation='relu'),
        layers.Dense(1)
    ])

history_sgd = build_model()
history_sgd.compile(optimizer=keras.optimizers.SGD(learning_rate=0.01), loss='mse')
h_sgd = history_sgd.fit(X_train, y_train, validation_data=(X_val, y_val), epochs=50, batch_size=32, verbose=0)

history_mom = build_model()
history_mom.compile(optimizer=keras.optimizers.SGD(learning_rate=0.01, momentum=0.9), loss='mse')
h_mom = history_mom.fit(X_train, y_train, validation_data=(X_val, y_val), epochs=50, batch_size=32, verbose=0)

history_adam = build_model()
history_adam.compile(optimizer=keras.optimizers.Adam(learning_rate=0.01), loss='mse')
h_adam = history_adam.fit(X_train, y_train, validation_data=(X_val, y_val), epochs=50, batch_size=32, verbose=0)

plt.figure(figsize=(9, 5))
plt.plot(h_sgd.history['loss'], label='SGD (lr=0.01)', color='red')
plt.plot(h_mom.history['loss'], label='SGD + Momentum (lr=0.01)', color='blue')
plt.plot(h_adam.history['loss'], label='Adam (lr=0.01)', color='green')
plt.xlabel('Epochs')
plt.ylabel('Training Loss (MSE)')
plt.title('Keras Model Training Loss across Optimizers')
plt.legend()
plt.grid(True)
plt.show()

lrs = [0.0001, 0.01, 1.0]
plt.figure(figsize=(10, 5))

for lr_val in lrs:
    model_lr = build_model()
    model_lr.compile(optimizer=keras.optimizers.SGD(learning_rate=lr_val), loss='mse')
    h_lr = model_lr.fit(X_train, y_train, epochs=30, batch_size=32, verbose=0)
    plt.plot(h_lr.history['loss'], label=f'SGD lr={lr_val}')

plt.xlabel('Epochs')
plt.ylabel('Training Loss')
plt.title('Effect of Varying Learning Rates (SGD)')
plt.ylim(0, 50)
plt.legend()
plt.grid(True)
plt.show()

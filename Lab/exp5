import numpy as np
import matplotlib.pyplot as plt
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error

np.random.seed(42)

n_samples = 150
X = np.sort(np.random.uniform(0, 1, n_samples)).reshape(-1, 1)
y_true = np.sin(2 * np.pi * X).ravel()
y = y_true + np.random.normal(0, 0.2, n_samples)

X_train, X_val, y_train, y_val = train_test_split(X, y, test_size=0.3, random_state=42)

degrees = [1, 3, 9, 15]
X_test_plot = np.linspace(0, 1, 200).reshape(-1, 1)

plt.figure(figsize=(14, 10))

for i, d in enumerate(degrees, 1):
    model = make_pipeline(PolynomialFeatures(d), LinearRegression())
    model.fit(X_train, y_train)
    y_pred_plot = model.predict(X_test_plot)
    
    plt.subplot(2, 2, i)
    plt.scatter(X_train, y_train, color='gray', alpha=0.6, label='Train data')
    plt.plot(X_test_plot, np.sin(2 * np.pi * X_test_plot), 'g--', label='True function')
    plt.plot(X_test_plot, y_pred_plot, 'r-', label=f'Degree {d} fit')
    plt.title(f'Polynomial Degree {d}')
    plt.xlabel('Area')
    plt.ylabel('Price')
    plt.ylim(-1.8, 1.8)
    plt.legend()
    plt.grid(True)

plt.tight_layout()
plt.show()

all_degrees = np.arange(1, 16)
train_errors = []
val_errors = []

for d in all_degrees:
    model = make_pipeline(PolynomialFeatures(d), LinearRegression())
    model.fit(X_train, y_train)
    
    y_tr_pred = model.predict(X_train)
    y_va_pred = model.predict(X_val)
    
    train_errors.append(mean_squared_error(y_train, y_tr_pred))
    val_errors.append(mean_squared_error(y_val, y_va_pred))

plt.figure(figsize=(8, 5))
plt.plot(all_degrees, train_errors, 'b-o', label='Training Error')
plt.plot(all_degrees, val_errors, 'r-o', label='Validation Error')
plt.xlabel('Model Complexity (Polynomial Degree)')
plt.ylabel('Mean Squared Error')
plt.title('Training vs Validation Error')
plt.ylim(0, 0.25)
plt.grid(True)
plt.legend()
plt.show()

n_bootstraps = 100
test_size = 50
X_test_bv = np.linspace(0, 1, test_size).reshape(-1, 1)
y_true_bv = np.sin(2 * np.pi * X_test_bv).ravel()

bias_squared_list = []
variance_list = []

for d in all_degrees:
    predictions = np.zeros((n_bootstraps, test_size))
    
    for b in range(n_bootstraps):
        boot_idx = np.random.choice(n_samples, n_samples, replace=True)
        X_boot = X[boot_idx]
        y_boot = y[boot_idx]
        
        model = make_pipeline(PolynomialFeatures(d), LinearRegression())
        model.fit(X_boot, y_boot)
        predictions[b, :] = model.predict(X_test_bv)
    
    main_pred = np.mean(predictions, axis=0)
    
    bias_squared = np.mean((main_pred - y_true_bv) ** 2)
    variance = np.mean(np.var(predictions, axis=0))
    
    bias_squared_list.append(bias_squared)
    variance_list.append(variance)

plt.figure(figsize=(8, 5))
plt.plot(all_degrees, bias_squared_list, 'g-o', label=r'Bias$^2$')
plt.plot(all_degrees, variance_list, 'm-o', label='Variance')
plt.plot(all_degrees, np.array(bias_squared_list) + np.array(variance_list), 'k--', label=r'Bias$^2$ + Variance')
plt.xlabel('Polynomial Degree')
plt.ylabel('Error')
plt.title('Bias-Variance Tradeoff')
plt.ylim(0, 0.2)
plt.grid(True)
plt.legend()
plt.show()

best_degree = all_degrees[np.argmin(val_errors)]
print("Best degree according to validation loss:", best_degree)

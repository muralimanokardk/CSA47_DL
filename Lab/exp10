
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import tensorflow as tf

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

np.random.seed(42)
tf.random.set_seed(42)

n = 500
features = np.random.randn(n, 8)

weights = np.array([0.8, -0.7, 0.6, 0.5, -0.4, 0.3, 0.2, -0.2])
probability = 1 / (1 + np.exp(-(features @ weights)))
target = np.random.binomial(1, probability)

X_train, X_test, y_train, y_test = train_test_split(
    features, target, test_size=0.2, random_state=42, stratify=target
)

scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)

def build_model(l2_value=0, dropout_rate=0):
    regularizer = tf.keras.regularizers.l2(l2_value)

    model = tf.keras.Sequential([
        tf.keras.layers.Input(shape=(X_train.shape[1],)),
        tf.keras.layers.Dense(256, activation="relu", kernel_regularizer=regularizer),
        tf.keras.layers.Dropout(dropout_rate),
        tf.keras.layers.Dense(128, activation="relu", kernel_regularizer=regularizer),
        tf.keras.layers.Dropout(dropout_rate),
        tf.keras.layers.Dense(64, activation="relu", kernel_regularizer=regularizer),
        tf.keras.layers.Dense(1, activation="sigmoid")
    ])

    model.compile(
        optimizer="adam",
        loss="binary_crossentropy",
        metrics=["accuracy"]
    )

    return model

results = []
histories = {}

def train_and_evaluate(name, model, early_stopping=False):
    callbacks = []

    if early_stopping:
        callbacks.append(
            tf.keras.callbacks.EarlyStopping(
                monitor="val_loss",
                patience=10,
                restore_best_weights=True
            )
        )

    history = model.fit(
        X_train, y_train,
        validation_split=0.2,
        epochs=100,
        batch_size=16,
        callbacks=callbacks,
        verbose=0
    )

    train_loss, train_accuracy = model.evaluate(X_train, y_train, verbose=0)
    test_loss, test_accuracy = model.evaluate(X_test, y_test, verbose=0)

    results.append([
        name,
        train_accuracy,
        test_accuracy,
        train_accuracy - test_accuracy
    ])

    histories[name] = history.history

model = build_model()
train_and_evaluate("Baseline", model)

for value in [0.001, 0.01, 0.1]:
    model = build_model(l2_value=value)
    train_and_evaluate(f"L2 {value}", model)

for rate in [0.2, 0.3, 0.5]:
    model = build_model(dropout_rate=rate)
    train_and_evaluate(f"Dropout {rate}", model)

model = build_model()
train_and_evaluate("Early Stopping", model, early_stopping=True)

results_df = pd.DataFrame(
    results,
    columns=["Model", "Training Accuracy", "Test Accuracy", "Train-Test Gap"]
)

print(results_df.to_string(index=False))

plt.figure(figsize=(10, 5))

for name in ["Baseline", "L2 0.001", "L2 0.01", "L2 0.1"]:
    plt.plot(histories[name]["val_loss"], label=name)

plt.xlabel("Epochs")
plt.ylabel("Validation Loss")
plt.title("L2 Regularisation Comparison")
plt.legend()
plt.show()

plt.figure(figsize=(10, 5))

for name in ["Baseline", "Dropout 0.2", "Dropout 0.3", "Dropout 0.5"]:
    plt.plot(histories[name]["val_loss"], label=name)

plt.xlabel("Epochs")
plt.ylabel("Validation Loss")
plt.title("Dropout Comparison")
plt.legend()
plt.show()

plt.figure(figsize=(8, 5))
plt.bar(results_df["Model"], results_df["Test Accuracy"])
plt.xticks(rotation=45)
plt.ylabel("Test Accuracy")
plt.title("Test Accuracy Comparison")
plt.tight_layout()
plt.show()

best_model = results_df.loc[results_df["Test Accuracy"].idxmax()]
print("\nBest Model:")
print(best_model)
